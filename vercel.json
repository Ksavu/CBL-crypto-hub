{
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/launch",
      "has": [
        {
          "type": "query",
          "key": "t"
        }
      ],
      "destination": "/xrplabs",
      "permanent": false
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "/bartender",
      "permanent": true
    },
    {
      "source": "/sniper",
      "destination": "/bartender",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
