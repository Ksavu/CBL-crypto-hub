{
 "functions": {
  "api/*.js": {
   "maxDuration": 30
  }
 },
 "rewrites": [
  {
   "source": "/launch",
   "destination": "/launch.html"
  },
  {
   "source": "/xrplabs",
   "destination": "/xrplabs.html"
  }
 ],
 "redirects": [
  {
   "source": "/launch",
   "has": [
    {
     "type": "query",
     "key": "t"
    }
   ],
   "destination": "/xrplabs",
   "permanent": false
  }
 ]
}